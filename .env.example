# API principal (Suporte API - Django/DRF) — docs: https://suportapi-production-e15c.up.railway.app/api/docs/
# O frontend acrescenta /api/v1 automaticamente (ver src/app/services/api.ts)
VITE_API_URL=https://suportapi-production-e15c.up.railway.app
VITE_CONCILIACAO_API_URL=https://api-conselho-production.up.railway.app

# API WhatsApp (FastAPI + Evolution/Electrosoft) — spec em doc_apiWhat.txt
# O WebSocket é derivado automaticamente (http -> ws + /ws); defina VITE_WHATSAPP_WS_URL só se for diferente.
VITE_WHATSAPP_API_URL=http://localhost:8000
# VITE_WHATSAPP_WS_URL=ws://localhost:8000/ws
